VITE_SUPABASE_URL=https://jouwprojectid.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-public-key-hier

# Alleen server-side gebruiken voor scripts/Supabase Edge Functions; nooit als VITE_* exposen.
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key-hier
IRACING_EMAIL=service-account@example.com
IRACING_PASSWORD=service-account-wachtwoord
TRACK_INTELLIGENCE_MEMBER_DELAY_MS=1000
# Extension upload API key — gedeeld geheim tussen extension en Edge Function
EXTENSION_API_KEY=kies-een-willekeurige-string

# PayPal Checkout — uitsluitend als Supabase Edge Function secrets configureren.
# Client ID mag naar de browser via de geauthenticeerde configresponse; alle overige waarden blijven server-side.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=jouw-sandbox-client-id
PAYPAL_CLIENT_SECRET=jouw-sandbox-client-secret
PAYPAL_MERCHANT_ID=jouw-sandbox-business-account-id
PAYPAL_WEBHOOK_ID=jouw-sandbox-webhook-id
PAYPAL_ALLOWED_ORIGINS=http://localhost:8080
PAYPAL_CHECKOUT_ENABLED=false
