VITE_SUPABASE_URL=https://jouwprojectid.supabase.co
VITE_SUPABASE_ANON_KEY=jouw-anon-public-key-hier

# Alleen server-side gebruiken voor scripts/Supabase Edge Functions; nooit als VITE_* exposen.
