{
  "manifest_version": 3,
  "name": "3 Stripe iRacing Content Scanner",
  "version": "0.6.2",
  "description": "Scans je iRacing content en uploadt tracks naar 3 Stripe Motorsport voor kalenderplanning.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://www.iracing.com/*",
    "https://members.iracing.com/*",
    "https://members-ng.iracing.com/*",
    "https://oauth.iracing.com/*",
    "https://3stripemotorsport.cc/*",
    "https://api.3stripemotorsport.cc/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://members-ng.iracing.com/web/racing/*",
        "https://www.iracing.com/cars-and-tracks*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "3 Stripe Track Scanner",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
