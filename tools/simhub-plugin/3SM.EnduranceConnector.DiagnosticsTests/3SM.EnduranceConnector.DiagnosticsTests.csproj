<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>3SM.EnduranceConnector.DiagnosticsTests</AssemblyName>
    <RootNamespace>ThreeSM.EnduranceConnector.DiagnosticsTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CA1416: de gedeelde lezer opent de iRacing-map alleen op Windows; op andere
         platformen gooit OpenExisting PlatformNotSupportedException, die de lezer zelf
         afvangt (SDK-14 test dat hier op Linux). De net48-plugin kent deze analyzer niet. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\3SM.EnduranceConnector\DiagnosticsClient.cs" Link="DiagnosticsClient.cs" />
    <Compile Include="..\3SM.EnduranceConnector\UpdaterStateStore.cs" Link="UpdaterStateStore.cs" />
    <Compile Include="..\3SM.EnduranceConnector\SessionTelemetryReader.cs" Link="SessionTelemetryReader.cs" />
    <Compile Include="..\3SM.EnduranceConnector\ConnectorSettings.cs" Link="ConnectorSettings.cs" />
    <!-- 0.8: de vlaggenlezer is SimHub-vrij en dus hier te testen. -->
    <Compile Include="..\3SM.EnduranceConnector\SessionFlagReader.cs" Link="SessionFlagReader.cs" />
    <!-- 0.8: eerlijke nullen. Alle drie SimHub-vrij: regels, bandenzones en de tracker. -->
    <Compile Include="..\3SM.EnduranceConnector\CaptureValueRules.cs" Link="CaptureValueRules.cs" />
    <Compile Include="..\3SM.EnduranceConnector\TyreZoneReader.cs" Link="TyreZoneReader.cs" />
    <Compile Include="..\3SM.EnduranceConnector\TyreSnapshotTracker.cs" Link="TyreSnapshotTracker.cs" />
    <Compile Include="..\3SM.EnduranceConnector\RawChannelReader.cs" Link="RawChannelReader.cs" />
    <!-- 0.8: versievergelijking van het updatepad, SimHub-vrij. -->
    <Compile Include="..\3SM.EnduranceConnector\UpdateVersionPolicy.cs" Link="UpdateVersionPolicy.cs" />
    <!-- 0.7.2.0: meetlaag. ID's, wire-DTO's, sampler en rondeaccumulator. -->
    <Compile Include="..\3SM.EnduranceConnector\MeasurementIds.cs" Link="MeasurementIds.cs" />
    <Compile Include="..\3SM.EnduranceConnector\MeasurementEvent.cs" Link="MeasurementEvent.cs" />
    <Compile Include="..\3SM.EnduranceConnector\TelemetrySampler.cs" Link="TelemetrySampler.cs" />
    <Compile Include="..\3SM.EnduranceConnector\LapAccumulator.cs" Link="LapAccumulator.cs" />
    <!-- 0.7.1: bandenhek + vingerafdruk. Beide bestanden zijn SimHub-vrij. -->
    <Compile Include="..\3SM.EnduranceConnector\TyrePublishGate.cs" Link="TyrePublishGate.cs" />
    <Compile Include="..\3SM.EnduranceConnector\TelemetryContractsV3.cs" Link="TelemetryContractsV3.cs" />
    <!-- 0.8.0: directe iRacing-SDK-lezer. Puur op bytes, dus hier met een synthetische
         memory-image te testen (geen SimHub-DLL, geen iRacing nodig). -->
    <Compile Include="..\3SM.EnduranceConnector\IrSdkChannels.cs" Link="IrSdkChannels.cs" />
    <Compile Include="..\3SM.EnduranceConnector\IrSdkMemoryReader.cs" Link="IrSdkMemoryReader.cs" />
  </ItemGroup>
  <!-- Vastgelegde baseline: gouden V3-frame, 0.7.1.2-configuratie en 0.7.1.2-updaterstaten. -->
  <ItemGroup>
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
